# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# Build directories
bin/
dist/
build/

# IDE directories
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local
.env.*.local
*.env

# Configuration files with secrets
config/local.yml
config/secrets.yml
*.secret.yml

# Database files
*.db
*.sqlite
*.sqlite3

# Log files
*.log
logs/
*.log.*

# Coverage reports
coverage/
*.coverprofile
coverage.out
coverage.html

# Temporary files
tmp/
temp/
*.tmp

# Docker volumes (if using local bind mounts)
data/
volumes/

# Kubernetes secrets
k8s-secrets/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!example.tfvars
crash.log

# Generated files
*.pb.go
*_gen.go
api/openapi/docs.go
api/openapi/swagger.json
api/openapi/swagger.yaml
mocks/

# OS files
Thumbs.db
.DS_Store

# Certificates and keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Backup files
*.bak
*.backup

# Node modules (if using any JS tools)
node_modules/

# Python (if using any Python tools)
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
pip-log.txt

# Development databases
*.development.db

# Local development overrides
docker-compose.override.yml
